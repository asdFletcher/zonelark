# Zonelark environment variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env — it contains secrets.

# ── ANTHROPIC_API_KEY (optional) ─────────────────────────────────────────
# How to get it: create a key at https://console.anthropic.com/settings/keys
# Not needed for demo mode or manual asset entry.
ANTHROPIC_API_KEY=

# ── IP_ALLOWLIST (optional) ───────────────────────────────────────────────
# Comma-separated list of client IPs allowed through when the app sits behind
# a reverse proxy that sets x-forwarded-for. Leave unset to allow everyone.
# IP_ALLOWLIST=

# ── Supabase (required for auth, persistence, admin console, autosave) ────
# Local dev: `npx supabase start` prints these values (requires Docker Desktop).
# Hosted: Project Settings -> API in your Supabase dashboard.
# SUPABASE_URL and SUPABASE_ANON_KEY are also exposed to the browser via the
# NEXT_PUBLIC_ variants below — same values, just readable client-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, bypasses RLS. NEVER expose this to the client
# or commit it. Used by app/api/admin/** for user management and by the
# CMMS/CRM sync + metrics pipelines.
SUPABASE_SERVICE_ROLE_KEY=
