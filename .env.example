# Copy to .env and fill in values. Never commit your .env file.
# Never fill in secret values in this file.

# Development setup: local Next.js server talks to remote Postgres DB hosted on Railway.
# This project is not set up for a local DB when doing dev work
#

# ── DATABASE_URL (required) ──────────────────────────────────────────────
# DATABASE_URL is the remote public Railway DB URL
DATABASE_URL=

# ── AUTH_SECRET (required) ───────────────────────────────────────────────
# Random key used to encrypt the login cookie. Generate with:
#   openssl rand -base64 32
# Used by local server to sign cookies.
AUTH_SECRET=

# ── AUTH_URL ─────────────────────────────────────────────────────────────
# Origin of this Next.js server. Local: http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── ANTHROPIC_API_KEY (optional) ─────────────────────────────────────────
# https://console.anthropic.com/settings/keys
# Only needed for AI photo assessment.
ANTHROPIC_API_KEY=
