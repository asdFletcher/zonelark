# Zonelark environment variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env — it contains secrets.

# ── ANTHROPIC_API_KEY (optional) ─────────────────────────────────────────
# How to get it: create a key at https://console.anthropic.com/settings/keys
# Not needed for demo mode or manual asset entry.
ANTHROPIC_API_KEY=
